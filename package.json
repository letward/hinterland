{
  "name": "hinterland",
  "productName": "Hinterland",
  "version": "1.39.0",
  "description": "Ein schneller, sicherer und frei anpassbarer Browser. A fast, secure and freely customisable browser.",
  "main": "src/main/main.js",
  "type": "module",
  "author": "Hinterland",
  "license": "MIT",
  "homepage": "https://hinterland-browser.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/letward/Hinterland.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.mjs",
    "test:sdk": "node --test sdk/test/*.test.mjs",
    "test": "node scripts/check.mjs && node --test sdk/test/*.test.mjs",
    "sdk": "node sdk/bin/hinterland-sdk.mjs",
    "icons": "node scripts/makeicon.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:store": "electron-builder --win appx --config build/electron-builder.store.json --publish never",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.hinterland",
    "productName": "Hinterland",
    "copyright": "Copyright © 2026 Hinterland Contributors",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "letward",
      "repo": "Hinterland",
      "releaseType": "release"
    },
    "asarUnpack": [
      "src/extensions/**/*"
    ],
    "protocols": [
      {
        "name": "Hinterland Web URL",
        "schemes": [
          "http",
          "https",
          "hinterland"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "icon": "build/icons/icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "icon": "build/icons/icon.ico",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/icon.png",
      "category": "Network;WebBrowser;",
      "maintainer": "Hinterland <security@hinterland.browser>",
      "synopsis": "A fast, secure and freely customisable browser.",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Hinterland",
      "uninstallDisplayName": "Hinterland Browser",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
