{
  "name": "hinterland",
  "productName": "Hinterland",
  "version": "1.26.0",
  "description": "Ein schneller, sicherer und frei anpassbarer Browser. A fast, secure and freely customisable browser.",
  "main": "src/main/main.js",
  "type": "module",
  "author": "Hinterland",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.mjs",
    "test:sdk": "node --test sdk/test/*.test.mjs",
    "test": "node scripts/check.mjs && node --test sdk/test/*.test.mjs",
    "sdk": "node sdk/bin/hinterland-sdk.mjs",
    "icons": "node scripts/makeicon.mjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.hinterland",
    "productName": "Hinterland",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "letward",
      "repo": "Hinterland"
    },
    "asarUnpack": [
      "src/extensions/**/*"
    ],
    "protocols": [
      {
        "name": "Hinterland Web URL",
        "schemes": [
          "http",
          "https",
          "hinterland"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "icon": "build/icons/icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "icon": "build/icons/icon.ico",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Hinterland",
      "uninstallDisplayName": "Hinterland Browser",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
